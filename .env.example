# OpenCode Go API
OPENCODE_GO_API_KEY=oc-go-xxxxxxxxxxxx
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-pro

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# Broker API (sesuaikan setelah broker dipilih)
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_BASE_URL=

# Trading Parameters
MAX_POSITION_SIZE=0.1
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.15
INITIAL_CAPITAL=100000000

# Database
DATABASE_URL=sqlite:////root/trading-bot/data/trading.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=/root/trading-bot/logs/trading.log
