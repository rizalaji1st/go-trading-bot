[Unit]
Description=Trading Bot Telegram Service
After=network.target trading-bot.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading-bot
ExecStart=/root/trading-bot/venv/bin/python /root/trading-bot/telegram_bot.py
Restart=always
RestartSec=10
KillSignal=SIGKILL
TimeoutStopSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/root/trading-bot/venv/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
